{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Unseen weekly timetable frontmatter",
  "type": "object",
  "required": ["type", "timezone", "classes"],
  "properties": {
    "type": { "const": "weekly_timetable" },
    "timezone": { "const": "Asia/Taipei" },
    "source_status": { "type": "string" },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["weekday", "subject", "start_time", "end_time", "day_status", "time_status"],
        "properties": {
          "weekday": { "type": "integer", "minimum": 1, "maximum": 5 },
          "subject": { "type": "string", "minLength": 1 },
          "start_time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "end_time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "location": { "type": ["string", "null"] },
          "instructor": { "type": ["string", "null"] },
          "day_status": { "enum": ["owner_confirmed", "screenshot_only"] },
          "time_status": { "enum": ["confirmed", "screenshot_unverified", "unknown_due_to_source_conflict"] }
        }
      }
    }
  }
}
